  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bnão é (?:só|apenas|somente) [^.!?\\n]{2,60}[,.] é\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diz a única coisa que você quer dizer. Apaga a metade da armação."
    },
    {
      "id": "nao-so-mas",
      "regex": "(?i)\\bnão (?:só|apenas|somente)\\b[^.!?\\n]{2,80}\\bmas (?:também|tambem)\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Quebra em duas frases, ou corta a metade mais fraca."
    },
    {
      "id": "nao-se-trata",
      "regex": "(?i)\\bnão se trata de [^.!?\\n]{2,60}[,.] (?:mas |e )?(?:sim )?de\\b|\\bnão é sobre [^.!?\\n]{2,60}[,.] é sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Começa pelo Y. A virada é o que denuncia."
    },
    {
      "id": "o-resultado",
      "regex": "(?i)^\\s*(?:o resultado|a melhor parte|o detalhe|o problema)\\?\\s*$",
      "name": "Linha de pergunta retórica sozinha",
      "fix": "Responde direto na frase em vez de encenar a revelação."
    },
    {
      "id": "o-que-aprendi",
      "regex": "(?i)\\b(?:aqui está|eis|olha) o que (?:eu )?aprendi\\b",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Fala a lição. Pula o anúncio."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b[\\wÀ-ÿ]+, [\\wÀ-ÿ]+ e [\\wÀ-ÿ]+\\.",
      "name": "Tríade (regra de três)",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão da máquina."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|inteligência artificial|modelo de linguagem)\\b",
      "name": "IA falando de si",
      "fix": "Apaga a frase."
    },
    {
      "id": "conclusao",
      "regex": "(?i)^\\s*(?:em resumo|em suma|concluindo|para concluir|em conclusão)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca",
      "regex": "(?i)\\b(?:concorda\\?|o que vocês acham\\?|quem mais\\b|tô errado\\?|estou errado\\?)\\s*$",
      "name": "Isca de engajamento no reflexo",
      "fix": "Faz uma pergunta que só você faria, sobre a coisa específica acima dela."
    },
    {
      "id": "nesse-video",
      "regex": "(?i)\\b(?:n[eo]ss?e (?:vídeo|video|reel|post)|no (?:vídeo|video) de hoje|hoje eu vou te mostrar|vou te (?:mostrar|ensinar) como)\\b",
      "name": "Preâmbulo (\"nesse vídeo vou te mostrar\")",
      "fix": "Apaga e começa no que interessa. Os dois primeiros segundos decidem o reel."
    },
    {
      "id": "segue-marca",
      "regex": "(?i)\\b(?:siga para mais|segue pra mais|marca alguém que|marque alguém que|dá dois toques|compartilha se)\\b",
      "name": "Pedido de follow ou marcação no reflexo",
      "fix": "Pede a única ação que esse post merece. O pedido genérico ensina o público a ignorar todos."
    }
  ]
}
